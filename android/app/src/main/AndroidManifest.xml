<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <permission
        android:name="org.example.foodblob.permission.READ_HEALTH_EXPORT"
        android:protectionLevel="signature" />

    <application
        android:name=".FoodBlobApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoodBlob"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="foodblob" android:host="today" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="foodblob" android:ssp="///today" />
            </intent-filter>
        </activity>

        <activity
            android:name=".quicklog.QuickLogActivity"
            android:directBootAware="false"
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.FoodBlob.Content" />

        <provider
            android:name=".integration.HealthExportProvider"
            android:authorities="org.example.foodblob.health_export"
            android:directBootAware="false"
            android:exported="true"
            android:grantUriPermissions="false"
            android:readPermission="org.example.foodblob.permission.READ_HEALTH_EXPORT" />

        <receiver
            android:name=".widget.SkyMeadowSmallWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_sky_meadow_small_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_small_info" />
        </receiver>
        <receiver
            android:name=".widget.ShrineSmallWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_shrine_small_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_small_shrine_info" />
        </receiver>
        <receiver
            android:name=".widget.SkyMeadowMediumWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_sky_meadow_medium_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_medium_info" />
        </receiver>
        <receiver
            android:name=".widget.ShrineMediumWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_shrine_medium_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_medium_shrine_info" />
        </receiver>

        <receiver
            android:name=".widget.FoodBlobWidgetActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.WidgetDayRolloverReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
